# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template committed
!.env.example

# Calendar data written by the JSON store. Real planned months are operational
# data, not source: they are large, they change constantly, and committing them
# was how two months of `[SAMPLE]` placeholder content ended up in the repo
# rendering as if it were the team's actual plan.
/data/calendars/*.json
