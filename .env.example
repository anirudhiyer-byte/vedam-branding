# ---------------------------------------------------------------------------
# Vedam — environment configuration
#
# Copy to .env.local and fill in. Every variable is declared and validated in
# lib/config/env.ts; `npm run check:env` reports what is missing and whether
# the result is safe to serve.
# ---------------------------------------------------------------------------

# --- Public site -----------------------------------------------------------
# Absolute origin of this deployment. Drives metadataBase, canonical URLs,
# robots.txt and the sitemap, so staging does not advertise production's URLs.
# REQUIRED in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Studio authentication -------------------------------------------------
# /studio triggers billed model calls and mutates the calendar. Both of these
# are REQUIRED in production; without them the Studio refuses to serve rather
# than falling open.
#
# Generate the secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=
# Session lifetime in seconds. Optional; defaults to 12 hours.
# STUDIO_SESSION_TTL_SECONDS=43200

# --- Model access ----------------------------------------------------------
# Required to plan calendars. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Enables YouTube channel + competitor research during generation.
# Google Cloud console -> enable "YouTube Data API v3" -> create an API key.
# Generation still works without it; the research step is skipped.
YOUTUBE_API_KEY=

# --- Cost controls ---------------------------------------------------------
# Hard ceiling on estimated model spend per calendar month, in USD. Checked
# before a run starts and between calls within a run. Strongly recommended.
AI_MONTHLY_BUDGET_USD=50

# Per-stage model overrides. Defaults are in lib/ai/models.ts:
#   theme        claude-opus-5      (one call, decides the whole month)
#   platformPlan claude-sonnet-5    (three calls, most of the output)
#   repurpose    claude-haiku-4-5   (mechanical rewrite of a fixed script)
# Set all three to the same model to measure what the tiering costs in quality.
# MODEL_THEME=claude-opus-5
# MODEL_PLATFORM_PLAN=claude-sonnet-5
# MODEL_REPURPOSE=claude-haiku-4-5

# Set to 1 to disable prompt caching, for A/B measuring its effect.
# AI_DISABLE_PROMPT_CACHE=

# --- Storage ---------------------------------------------------------------
# When set, calendars are stored in Postgres. When unset, they fall back to
# JSON files under data/calendars — fine for local development and a single
# Node process, and broken on any read-only or multi-instance host.
# DATABASE_URL=postgres://user:password@localhost:5432/vedam

# --- Real profile URLs -----------------------------------------------------
# Deliberately unset. The Studio hides its "open our channel" links rather than
# linking to a guessed handle that may not be ours. Fill in once confirmed.
# VEDAM_INSTAGRAM_URL=
# VEDAM_LINKEDIN_URL=
# VEDAM_YOUTUBE_URL=
