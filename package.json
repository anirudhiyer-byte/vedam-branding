{
  "name": "vedam-branding",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:sample": "node --experimental-strip-types --no-warnings scripts/seed-sample.ts",
    "check:slots": "node --experimental-strip-types --no-warnings scripts/check-slots.ts",
    "check:storage": "node --experimental-strip-types --no-warnings scripts/check-storage.ts",
    "check": "npm run check:slots && npm run check:storage && npm run check:merge && npm run check:contrast && npm run check:agent",
    "check:merge": "node --experimental-strip-types --no-warnings scripts/check-merge.ts",
    "check:contrast": "node --experimental-strip-types --no-warnings scripts/check-contrast.ts",
    "check:keys": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/check-keys.ts",
    "check:agent": "node --experimental-strip-types --no-warnings scripts/check-agent.ts",
    "check:stream": "node --env-file=.env.local --experimental-strip-types --no-warnings scripts/check-stream.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
